; C <-> Rust differential equivalence for byte-array outputs through the
; klee_dump_expr_mem hook: the C twin of demos/klee-deq-dump-bytes is
; compiled with clang, both sides run under KLEE, and the dumped output
; byte-region expressions are proven equivalent (cross-product with the
; path-compatibility gate) with Z3.
; RUN: rm -rf %t.cdir %t.dumps && mkdir -p %t.cdir %t.dumps
; RUN: clang-18 -I %rvt_dir/tools/klee/include -emit-llvm -c %S/c_hex_decode.c -o %t.cdir/c_hex_decode.bc
; RUN: KLEE_DUMP_DIR=%t.dumps %klee --exit-on-error --entry-point=main --libc=klee --output-dir=%t.cdir/c-klee-out %t.cdir/c_hex_decode.bc 2>&1 | %FileCheck %s --check-prefix=KLEE-C
; KLEE-C: KLEE: done: completed paths = {{[1-9][0-9]*}}
; RUN: rm -rf %S/../../demos/klee-deq-dump-bytes/target
; RUN: export KLEE_DUMP_DIR=%t.dumps/rust && mkdir -p %t.dumps/rust && cd %S/../../demos/klee-deq-dump-bytes && %cargo-verify --backend=klee 2>&1 | %FileCheck %s --check-prefix=RUST
; RUST: VERIFICATION_RESULT: VERIFIED
; RUN: %python %rvt_dir/scripts/compare-klee-dump-sets.py %t.dumps %t.dumps/rust --tag out_hex | %FileCheck %s --check-prefix=EQUIV
; EQUIV: DUMPSET_OK pairs={{[0-9]+}} unsat={{[0-9]+}} sat=0 timeout=0 incompatible={{[0-9]+}} other=0 all_ok=true
